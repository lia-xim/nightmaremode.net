---
import BaseLayout from "@/components/BaseLayout.astro";
import SiteFooter from "@/components/SiteFooter.astro";
---

<BaseLayout title="Contact" noindex>
  <section class="page-hero shell">
    <div class="page-hero__rail mono">Contact / no submission form</div>
    <div class="page-hero__copy"><p class="mono signal">Small publication / direct responsibility</p><h1 class="display">Use the route that fits the record.</h1><p>Nightmare Mode does not currently accept unsolicited pitches or operate a newsletter. Factual corrections, attribution questions and rights concerns use the dedicated contact route.</p><a class="action" href="/rights-contact/">Rights and corrections</a></div>
  </section>
  <SiteFooter />
</BaseLayout>
