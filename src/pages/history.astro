---
import { Image } from "astro:assets";
import BaseLayout from "@/components/BaseLayout.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import archiveImage from "@/assets/legacy-archive.png";
---

<BaseLayout title="History & New Operation" description="A limited identity and rights boundary for the independent 2026 Nightmare Mode operation." noindex>
  <article class="history shell">
    <div class="history-copy">
      <p class="mono accent">History / Separate operation</p>
      <h1 class="display">The domain has a past. This publication is separate.</h1>
      <p class="lead">The domain was used by an earlier games publication. The current project states that public fact without claiming its staff, work, reputation or legal identity.</p>
      <hr class="rule" />
      <h2>New ownership, stated plainly</h2>
      <p>This is a new editorial operation launched in 2026. We are not the earlier staff and do not claim continuous organizational identity. New articles are commissioned and edited by the current operation.</p>
      <h2>The archive, handled carefully</h2>
      <p>A small number of historical URLs remain as limited bibliographic and rights-contact records. Original article text, images and downloads are reproduced only where permission or a suitable license has been confirmed.</p>
      <h2>A living publication</h2>
      <p>The current publication produces its own work about contemporary questions in games and culture. Similar subject matter does not imply continuity or endorsement.</p>
    </div>
    <div class="history-image broken-frame">
      <Image src={archiveImage} alt="Abstract archival layers connected by a luminous line" widths={[560, 860]} sizes="(max-width: 800px) 100vw, 42vw" format="webp" />
    </div>
  </article>
  <SiteFooter />
</BaseLayout>

<style>
  .history { display: grid; grid-template-columns: 1fr 0.78fr; gap: clamp(3rem, 8vw, 8rem); align-items: start; padding-block: var(--section); }
  h1 { margin: 1rem 0 3rem; font-size: clamp(4.5rem, 8vw, 8.5rem); }
  .lead { font-family: var(--serif); font-size: clamp(1.6rem, 2.5vw, 2.3rem); line-height: 1.15; }
  .history-copy > p:not(.lead) { max-width: 48rem; color: var(--paper-dim); }
  h2 { margin-top: 3rem; color: var(--acid); font-family: var(--mono); font-size: 0.8rem; letter-spacing: 0.08em; text-transform: uppercase; }
  .rule { margin-block: 3rem; }
  .history-image { position: sticky; top: 2rem; margin-top: 8rem; }
  .history-image :global(img) { width: 100%; aspect-ratio: 0.92; object-fit: cover; }
  @media (max-width: 800px) { .history { grid-template-columns: 1fr; } .history-image { position: static; margin-top: 0; } h1 { font-size: clamp(4rem, 19vw, 6.5rem); } }
</style>
