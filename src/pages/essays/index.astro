---
import { Image } from "astro:assets";
import BaseLayout from "@/components/BaseLayout.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import studyImage from "@/assets/nightmare-field-study.png";
---

<BaseLayout title="Essays" description="Original, source-led essays about games, preservation, systems and culture.">
  <section class="page-hero shell">
    <div class="page-hero__rail mono">Essays / original work</div>
    <div class="page-hero__copy">
      <p class="mono signal">Arguments with visible evidence</p>
      <h1 class="display">Essays</h1>
      <p>Long-form work about games and culture, published slowly enough to show its sources, methods and limits.</p>
    </div>
  </section>
  <section class="essay-list shell" aria-labelledby="latest-essay">
    <a class="essay-card" href="/essays/a-game-is-more-than-its-files/">
      <div class="essay-card__image"><Image src={studyImage} alt="Original monochrome study of layered screens and archival structures" widths={[640, 960, 1280]} sizes="(max-width: 760px) 100vw, 48vw" format="webp" /></div>
      <div class="essay-card__copy">
        <p class="mono signal">Essay / 22 August 2026</p>
        <h2 id="latest-essay" class="display">A game is more than its files</h2>
        <p>Preservation can keep code, media and hardware within reach. Criticism still has to account for the conditions that made play possible.</p>
        <span class="action">Read the essay <span aria-hidden="true">→</span></span>
      </div>
    </a>
  </section>
  <SiteFooter />
</BaseLayout>

<style>
  .essay-list { padding-block: var(--section); }
  .essay-card { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2.5rem, 7vw, 7rem); align-items: center; }
  .essay-card__image { overflow: hidden; }
  .essay-card__image :global(img) { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  .essay-card__copy { max-width: 36rem; }
  h2 { margin: 1rem 0 1.5rem; font-size: clamp(3.5rem, 6vw, 6.4rem); }
  .essay-card__copy > p:not(.signal) { color: var(--ink-soft); font-size: 1.15rem; }
  .action { margin-top: 1.5rem; }
  @media (max-width: 760px) { .essay-card { grid-template-columns: 1fr; } }
</style>
