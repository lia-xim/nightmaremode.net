---
import BaseLayout from "@/components/BaseLayout.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import { legacyManifestVersion, legacyUrlActions } from "@/data/legacy-url-actions";
---

<BaseLayout title="Archive ledger" description="A rights-aware ledger of reviewed former Nightmare Mode URLs." noindex>
  <section class="page-hero shell">
    <div class="page-hero__rail mono">Manifest / {legacyManifestVersion}</div>
    <div class="page-hero__copy">
      <p class="mono signal">Bibliographic facts / rights / intent</p>
      <h1 class="display">The past is evidence. Not inventory.</h1>
      <p>Old URLs are reviewed one by one. Nothing is restored, redirected or retired without a recorded reason.</p>
    </div>
  </section>

  <section class="records shell" aria-labelledby="records-title">
    <h2 id="records-title" class="sr-only">Legacy URL actions</h2>
    {legacyUrlActions.map((record, index) => (
      <article>
        <span class="mono signal">{String(index + 1).padStart(2, "0")}</span>
        <div><h3>{record.formerTitle}</h3><p class="mono">{record.normalizedPath}</p></div>
        <div><span class="mono">Rights</span><strong>{record.rightsStatus}</strong></div>
        <div><span class="mono">Action</span><strong>{record.action.replace("_", " ")}</strong></div>
      </article>
    ))}
    <p class="notice">These records do not reproduce former article bodies and do not imply permission, endorsement, or editorial continuity. `Hold` is not a redirect decision.</p>
  </section>
  <SiteFooter />
</BaseLayout>

<style>
  .records { padding: var(--section) clamp(1.5rem, 5vw, 5rem); border-inline: 1px solid var(--line); }
  article { display: grid; grid-template-columns: 3rem minmax(0, 1fr) minmax(8rem, 0.25fr) minmax(8rem, 0.25fr); gap: 1rem; align-items: center; padding-block: 1.4rem; border-top: 1px solid var(--line); }
  article:last-of-type { border-bottom: 1px solid var(--line); }
  h3 { margin: 0; font-family: var(--display); font-size: clamp(1.5rem, 2.4vw, 2.5rem); line-height: 0.95; text-transform: uppercase; }
  article p { margin: 0.5rem 0 0; overflow-wrap: anywhere; }
  article > div > span { display: block; }
  article strong { text-transform: uppercase; }
  .notice { max-width: 52rem; margin-top: 2rem; font-family: var(--mono); font-size: 0.75rem; }
  @media (max-width: 720px) { article { grid-template-columns: 2rem 1fr; } article > div:nth-child(n+3) { grid-column: 2; } }
</style>
