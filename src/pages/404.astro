---
import BaseLayout from "@/components/BaseLayout.astro";
import SiteFooter from "@/components/SiteFooter.astro";
---

<BaseLayout title="Page not found" noindex>
  <section class="page-hero shell">
    <div class="page-hero__rail mono">Response / 404</div>
    <div class="page-hero__copy"><p class="mono signal">No reviewed destination</p><h1 class="display">This path ends here.</h1><p>There is no intent-equivalent page at this address. Unknown historical URLs are not redirected to the homepage.</p><a class="action action--solid" href="/">Return to the field laboratory</a></div>
  </section>
  <SiteFooter />
</BaseLayout>
