  ],
  contextterLink: "Visit Crawl Foundry",
  disclosure: "Conflict disclosure: Matthias Ramahi operates Nightmare Mode and Crawl Foundry. The link identifies the operator relationship; it is not an independent recommendation. No ranking, traffic or customer result is claimed for this project.",
};

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: copy.title,
  description: copy.description,
  datePublished: "2026-08-28",
  dateModified: "2026-08-29",
  inLanguage: locale === "de" ? "de-DE" : "en",
  author: { "@type": "Person", name: "Matthias Ramahi" },
  editor: { "@type": "Person", name: "Matthias Ramahi" },
  mainEntityOfPage: `https://nightmaremode.net${Astro.url.pathname}`,
};
const hrefFor = (href: string) => href.endsWith(".json") ? href : href.startsWith("/") ? pathFor(locale, href) : href;
---

<BaseLayout lang={locale} title={copy.title} description={copy.description} ogType="article">
  <script slot="head" is:inline type="application/ld+json" set:html={JSON.stringify(articleSchema)}></script>

  <header class="case-hero shell">
    <div class="case-hero__meta">
      <p class="mono">{locale === "de" ? "Offene Fallstudie · Stand 29. August 2026" : "Open case study · 29 August 2026"}</p>
      <p>{locale === "de" ? "Verantwortlich: Matthias Ramahi" : "Responsible editor: Matthias Ramahi"}</p>
    </div>
    <div>
      <h1 class="display">{copy.title}</h1>
      <p class="dek">{copy.summary}</p>
    </div>
  </header>

  <section class="fact-sheet shell" aria-label={locale === "de" ? "Projektüberblick" : "Project overview"}>
    {copy.facts.map(([term, value]) => <div><p class="fact-term">{term}</p><p class="fact-value">{value}</p></div>)}
  </section>

  <article class="case-body shell">
    <section class="chapter">
      <div class="chapter__rail"><span>01</span><h2 class="display">{copy.foundTitle}</h2></div>
      <div class="chapter__content"><p class="lead">{copy.foundIntro}</p><ol class="timeline">{copy.timeline.map(([date, text]) => <li><time>{date}</time><p>{text}</p></li>)}</ol></div>
    </section>

    <section class="chapter chapter--signal">
      <div class="chapter__rail"><span>02</span><h2 class="display">{copy.mistakeTitle}</h2></div>
      <div class="chapter__content prose">{copy.mistake.map((paragraph) => <p>{paragraph}</p>)}</div>
    </section>

    <section class="chapter">
      <div class="chapter__rail"><span>03</span><h2 class="display">{copy.decisionsTitle}</h2></div>
      <div class="chapter__content decision-list">{copy.decisions.map(([title, body]) => <section><h3 class="display">{title}</h3><p>{body}</p></section>)}</div>
    </section>

    <section class="chapter">
      <div class="chapter__rail"><span>04</span><h2 class="display">{copy.contextTitle}</h2></div>
      <div class="chapter__content"><p class="lead">{copy.contextIntro}</p><div class="work-list">{copy.work.map(([title, body]) => <section><h3>{title}</h3><p>{body}</p></section>)}</div><aside class="boundary"><p>{copy.productBoundary}</p></aside></div>
    </section>

    <section class="chapter evidence-chapter">
      <div class="chapter__rail"><span>05</span><h2 class="display">{copy.evidenceTitle}</h2></div>
      <div class="chapter__content evidence-list">{copy.evidence.map(([state, claim]) => <div><strong>{state}</strong><p>{claim}</p></div>)}</div>
    </section>

    <section class="chapter">
      <div class="chapter__rail"><span>06</span><h2 class="display">{copy.measurementTitle}</h2></div>
      <div class="chapter__content"><p class="lead">{copy.measurementIntro}</p><dl class="measurement-list">{copy.measurementRows.map(([term, value]) => <div><dt>{term}</dt><dd>{value}</dd></div>)}</dl><h3 class="hypothesis-title display">{copy.hypothesesTitle}</h3><div class="hypothesis-list">{copy.hypotheses.map(([state, text]) => <div><strong>{state}</strong><p>{text}</p></div>)}</div></div>
    </section>

    <section class="chapter">
      <div class="chapter__rail"><span>07</span><h2 class="display">{copy.resultsTitle}</h2></div>
      <div class="chapter__content"><ul class="plain-list">{copy.results.map((item) => <li>{item}</li>)}</ul></div>
    </section>

    <section class="chapter checklist-chapter">
      <div class="chapter__rail"><span>08</span><h2 class="display">{copy.checklistTitle}</h2></div>
      <div class="chapter__content"><p class="lead">{copy.checklistIntro}</p><ol class="checklist">{copy.checklist.map((item, index) => <li><span>{String(index + 1).padStart(2, "0")}</span><p>{item}</p></li>)}</ol></div>
    </section>

    <section class="chapter">
      <div class="chapter__rail"><span>09</span><h2 class="display">{copy.nextTitle}</h2></div>
      <div class="chapter__content next-list">{copy.next.map(([title, body]) => <section><h3>{title}</h3><p>{body}</p></section>)}</div>
    </section>

    <section class="chapter proof-chapter">
      <div class="chapter__rail"><span>10</span><h2 class="display">{copy.proofTitle}</h2></div>
      <div class="chapter__content"><p class="lead">{copy.proofIntro}</p><ul class="proof-links">{copy.proofLinks.map(([label, href]) => <li><a href={hrefFor(href)} rel={href.startsWith("http") ? "external" : undefined} data-umami-event="evidence-open" data-umami-event-target={href}>{label} <span aria-hidden="true">↗</span></a></li>)}</ul><p class="disclosure">{copy.disclosure}</p><a class="action" href="https://crawlfoundry.com/" rel="external" data-umami-event="contextter-visit" data-umami-event-placement="case-study-disclosure">{copy.contextterLink} <span aria-hidden="true">↗</span></a></div>
    </section>
  </article>

  <SiteFooter locale={locale} />
</BaseLayout>

<style>
  .case-hero { display: grid; grid-template-columns: minmax(13rem, 0.28fr) 1fr; gap: clamp(2rem, 7vw, 8rem); padding-block: clamp(4.5rem, 9vw, 9rem); border-bottom: 1px solid var(--line); }
  .case-hero__meta { padding-top: 0.6rem; color: var(--ink-soft); font-size: 0.88rem; }
  .case-hero__meta .mono { margin: 0 0 1rem; color: var(--signal); }
  .case-hero h1 { max-width: 15ch; font-size: clamp(3.5rem, 6.8vw, 7rem); }
  .dek { max-width: 54rem; margin: 2rem 0 0; color: var(--ink-soft); font-family: var(--display); font-size: clamp(1.35rem, 2.2vw, 2rem); line-height: 1.35; }
  .fact-sheet { display: grid; grid-template-columns: repeat(3, 1fr); border-bottom: 1px solid var(--line); }
  .fact-sheet div { padding: 1.7rem clamp(1.25rem, 2.5vw, 2.5rem); border-left: 1px solid var(--line); }
  .fact-sheet div:nth-child(3n + 1) { padding-left: 0; border-left: 0; }
  .fact-term { margin: 0; color: var(--signal); font-size: 0.75rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; }
  .fact-value { margin: 0.45rem 0 0; color: var(--ink-soft); }
  .case-body { padding-bottom: clamp(4rem, 8vw, 8rem); }
  .chapter { display: grid; grid-template-columns: minmax(15rem, 0.32fr) 1fr; gap: clamp(2.5rem, 7vw, 8rem); padding-block: clamp(4rem, 8vw, 8rem); border-bottom: 1px solid var(--line); }
  .chapter__rail > span { color: var(--signal); font-size: 0.78rem; }
  .chapter__rail h2 { max-width: 9ch; margin-top: 0.75rem; font-size: clamp(2.5rem, 4.3vw, 4.7rem); }
  .chapter__content { min-width: 0; }
  .lead { max-width: 46rem; margin: 0 0 2.5rem; font-family: var(--display); font-size: clamp(1.4rem, 2.25vw, 2.05rem); line-height: 1.35; }
  .prose { max-width: 49rem; }
  .prose p { margin: 0 0 1.4rem; font-size: clamp(1.05rem, 1.35vw, 1.2rem); }
  .chapter--signal { background: var(--paper-soft); box-shadow: 0 0 0 100vmax var(--paper-soft); clip-path: inset(0 -100vmax); }
  .timeline { margin: 0; padding: 0; list-style: none; }
  .timeline li { display: grid; grid-template-columns: 8rem 1fr; gap: 2rem; padding: 1.5rem 0; border-top: 1px solid var(--line); }
  .timeline time { color: var(--signal); font-weight: 550; }
  .timeline p { max-width: 46rem; margin: 0; color: var(--ink-soft); }
  .decision-list > section { display: grid; grid-template-columns: minmax(13rem, 0.42fr) 1fr; gap: clamp(1.5rem, 4vw, 4rem); padding: 2rem 0; border-top: 1px solid var(--line); }
  .decision-list h3 { font-size: clamp(1.55rem, 2.4vw, 2.35rem); }
  .decision-list p, .work-list p, .next-list p { max-width: 42rem; margin: 0; color: var(--ink-soft); }
  .work-list { display: grid; grid-template-columns: 1fr 1fr; }
  .work-list section { padding: 1.75rem 2rem 1.75rem 0; border-top: 1px solid var(--line); }
  .work-list section:nth-child(even) { padding-left: 2rem; border-left: 1px solid var(--line); }
  .work-list h3, .next-list h3 { margin: 0 0 0.5rem; font-size: 1.15rem; }
  .boundary { margin-top: 2.5rem; padding: 1.5rem 0 0 2rem; border-top: 1px solid var(--line); border-left: 3px solid var(--signal); }
  .boundary p { max-width: 46rem; margin: 0; }
  .evidence-list > div { display: grid; grid-template-columns: 8.5rem 1fr; gap: 2rem; padding: 1.4rem 0; border-top: 1px solid var(--line); }
  .evidence-list strong { color: var(--signal); font-size: 0.82rem; }
  .evidence-list p { max-width: 48rem; margin: 0; color: var(--ink-soft); }
  .measurement-list { margin: 0; }
  .measurement-list > div { display: grid; grid-template-columns: 8.5rem 1fr; gap: 2rem; padding: 1.4rem 0; border-top: 1px solid var(--line); }
  .measurement-list dt, .hypothesis-list strong { color: var(--signal); font-size: 0.82rem; font-weight: 600; }
  .measurement-list dd { max-width: 48rem; margin: 0; color: var(--ink-soft); }
  .hypothesis-title { margin: 4rem 0 1.25rem; font-size: clamp(2rem, 3vw, 3rem); }
  .hypothesis-list > div { display: grid; grid-template-columns: 8.5rem 1fr; gap: 2rem; padding: 1.25rem 0; border-top: 1px solid var(--line); }
  .hypothesis-list p { max-width: 48rem; margin: 0; }
  .plain-list { margin: 0; padding: 0; list-style: none; }
  .plain-list li { padding: 1.35rem 0 1.35rem 2rem; border-top: 1px solid var(--line); font-family: var(--display); font-size: clamp(1.35rem, 2vw, 1.85rem); line-height: 1.35; position: relative; }
  .plain-list li::before { content: ""; position: absolute; left: 0; top: 2.1rem; width: 0.55rem; height: 0.55rem; background: var(--signal); }
  .checklist { margin: 0; padding: 0; list-style: none; counter-reset: item; }
  .checklist li { display: grid; grid-template-columns: 3rem 1fr; gap: 1.25rem; padding: 1.25rem 0; border-top: 1px solid var(--line); }
  .checklist span { color: var(--signal); font-size: 0.78rem; }
  .checklist p { max-width: 45rem; margin: 0; }
  .next-list section { display: grid; grid-template-columns: 9rem 1fr; gap: 2rem; padding: 1.5rem 0; border-top: 1px solid var(--line); }
  .proof-links { margin: 0 0 2.5rem; padding: 0; list-style: none; }
  .proof-links li { border-top: 1px solid var(--line); }
  .proof-links a { display: flex; justify-content: space-between; gap: 2rem; padding: 1.1rem 0; color: var(--signal); }
  .proof-links a:hover { color: var(--ink); }
  .disclosure { max-width: 46rem; color: var(--ink-soft); }
  @media (max-width: 860px) {
    .case-hero, .chapter { grid-template-columns: 1fr; gap: 2rem; }
    .case-hero__meta { order: 2; }
    .fact-sheet { grid-template-columns: 1fr 1fr; }
    .fact-sheet div:nth-child(3n + 1) { padding-left: clamp(1.25rem, 2.5vw, 2.5rem); border-left: 1px solid var(--line); }
    .fact-sheet div:nth-child(odd) { padding-left: 0; border-left: 0; }
    .chapter__rail h2 { max-width: 14ch; }
  }
  @media (max-width: 620px) {
    .fact-sheet, .work-list { grid-template-columns: 1fr; }
    .fact-sheet div, .fact-sheet div:nth-child(3n + 1) { padding-inline: 0; border-top: 1px solid var(--line); border-left: 0; }
    .timeline li, .decision-list > section, .evidence-list > div, .measurement-list > div, .hypothesis-list > div, .next-list section { grid-template-columns: 1fr; gap: 0.65rem; }
    .work-list section, .work-list section:nth-child(even) { padding-inline: 0; border-left: 0; }
  }
</style>
