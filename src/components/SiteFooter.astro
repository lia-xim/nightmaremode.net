---
import { footerNavigation, localeFromPath, type Locale } from "@/i18n";

interface Props { locale?: Locale }
const { locale = localeFromPath(Astro.url.pathname) } = Astro.props;
const footerLinks = footerNavigation[locale];
---

<footer class="site-footer">
  <div class="site-footer__inner shell">
    <div>
      <a class="footer-brand" href={locale === "de" ? "/de/" : "/"}>Nightmare Mode</a>
      <p>{locale === "de" ? "Offene Fallstudie eines rechtssicheren Domain-Neuaufbaus – mit Games-Essays und Play Studies als redaktioneller Probe." : "An open case study in rebuilding an editorial domain safely, with games essays and play studies as the editorial test."}</p>
    </div>
    <nav aria-label="Footer navigation">
      {footerLinks.map(([label, href]) => <a href={href}>{label}</a>)}
    </nav>
  </div>
</footer>

<style>
  .site-footer { border-top: 1px solid var(--line); }
  .site-footer__inner {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 3rem;
    align-items: end;
    padding-block: clamp(3.5rem, 6vw, 6rem);
  }
  .footer-brand { font-family: var(--display); font-size: clamp(2rem, 3vw, 2.75rem); letter-spacing: -0.035em; }
  p { margin: 0.65rem 0 0; color: var(--ink-soft); font-size: 0.92rem; }
  nav { display: flex; flex-wrap: wrap; gap: clamp(1.5rem, 3vw, 3.5rem); }
  nav a { color: var(--ink-soft); font-size: 0.9rem; }
  nav a:hover { color: var(--signal); }
  @media (max-width: 700px) {
    .site-footer__inner { grid-template-columns: 1fr; align-items: start; }
    nav { gap: 1.5rem; }
  }
</style>
