---
import { navItems } from "@/data/site";

const path = Astro.url.pathname;
---

<header class="site-header">
  <div class="site-header__inner shell">
    <a class="brand" href="/" aria-label="Nightmare Mode home">Nightmare Mode</a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
      <span>Menu</span>
    </button>
    <nav id="site-nav" aria-label="Primary navigation">
      {navItems.map((item) => (
        <a class:list={{ active: path.startsWith(item.href) }} href={item.href}>{item.label}</a>
      ))}
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>(".menu-toggle");
  const label = toggle?.querySelector("span");
  const nav = document.querySelector<HTMLElement>("#site-nav");

  const setOpen = (open: boolean) => {
    toggle?.setAttribute("aria-expanded", String(open));
    nav?.classList.toggle("open", open);
    if (label) label.textContent = open ? "Close" : "Menu";
  };

  toggle?.addEventListener("click", () => setOpen(toggle.getAttribute("aria-expanded") !== "true"));
  nav?.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => setOpen(false)));
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 30;
    border-bottom: 1px solid var(--line);
    background: color-mix(in srgb, var(--paper) 94%, transparent);
    backdrop-filter: blur(12px);
  }

  .site-header__inner {
    display: flex;
    min-height: 6.25rem;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .brand {
    font-family: var(--display);
    font-size: clamp(1.6rem, 2.3vw, 2.25rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.035em;
  }

  nav { display: flex; align-items: center; gap: clamp(1.5rem, 3vw, 3.25rem); }

  nav a {
    position: relative;
    padding-block: 0.5rem;
    color: var(--ink-soft);
    font-size: 0.93rem;
    font-weight: 480;
  }

  nav a::after {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 1px;
    content: "";
    background: var(--signal);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 180ms ease;
  }

  nav a:hover,
  nav a.active { color: var(--ink); }
  nav a:hover::after,
  nav a.active::after { transform: scaleX(1); transform-origin: left; }

  .menu-toggle {
    display: none;
    padding: 0.45rem 0;
    border: 0;
    border-bottom: 1px solid transparent;
    background: transparent;
    color: var(--ink-soft);
    cursor: pointer;
  }

  .menu-toggle:hover { border-color: var(--signal); color: var(--ink); }

  @media (max-width: 820px) {
    .site-header__inner { min-height: 5.25rem; }
    .menu-toggle { display: block; }
    nav {
      position: absolute;
      top: 100%;
      right: 0;
      left: 0;
      display: none;
      padding: 1.25rem var(--gutter) 2rem;
      border-bottom: 1px solid var(--line);
      background: var(--paper);
    }
    nav.open { display: grid; gap: 0; }
    nav a { padding-block: 0.85rem; border-bottom: 1px solid var(--line); font-family: var(--display); font-size: 1.8rem; }
  }
</style>
