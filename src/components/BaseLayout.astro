---
import Header from "@/components/Header.astro";
import { siteConfig } from "@/config/site";
import { isIndexingEnabled } from "@/config/indexing-gate.mjs";
import { alternatePath, localeFromPath, type Locale } from "@/i18n";
import "@/styles/global.css";
import "@/styles/responsive-fixes.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  ogType?: "website" | "article";
  lang?: Locale;
}

const {
  title = "Nightmare Mode — Games, examined closely",
  description = siteConfig.description,
  image = "/og-default.jpg",
  noindex = false,
  ogType = "website",
  lang = localeFromPath(Astro.url.pathname),
} = Astro.props;

const canonical = new URL(Astro.url.pathname, siteConfig.canonicalHost);
const fullTitle = title.includes("Nightmare Mode") ? title : `${title} — Nightmare Mode`;
const indexingEnabled = isIndexingEnabled(import.meta.env);
const shouldNoindex = noindex || !indexingEnabled;
const languageAlternate = alternatePath(Astro.url.pathname);
const englishPath = lang === "en" ? Astro.url.pathname : languageAlternate;
const germanPath = lang === "de" ? Astro.url.pathname : languageAlternate;
const websiteId = new URL("/#website", siteConfig.canonicalHost).toString();
const pageId = new URL(`${Astro.url.pathname}#webpage`, siteConfig.canonicalHost).toString();
const pageSchema = ["/", "/de/"].includes(Astro.url.pathname)
  ? {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "@id": websiteId,
      name: siteConfig.name,
      url: siteConfig.canonicalHost,
      description,
    }
  : {
      "@context": "https://schema.org",
      "@type": "WebPage",
      "@id": pageId,
      name: fullTitle,
      url: canonical.toString(),
      description,
      isPartOf: { "@id": websiteId },
    };
---

<!doctype html>
<html lang={lang} data-indexing={shouldNoindex ? "blocked" : "enabled"}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {englishPath && <link rel="alternate" hreflang="en" href={new URL(englishPath, siteConfig.canonicalHost)} />}
    {germanPath && <link rel="alternate" hreflang="de" href={new URL(germanPath, siteConfig.canonicalHost)} />}
    {englishPath && <link rel="alternate" hreflang="x-default" href={new URL(englishPath, siteConfig.canonicalHost)} />}
    <meta name="robots" content={shouldNoindex ? "noindex, nofollow" : "index, follow"} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, siteConfig.canonicalHost)} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(pageSchema)}></script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">{lang === "de" ? "Zum Inhalt" : "Skip to content"}</a>
    <Header locale={lang} />
    <main id="main-content">
      <slot />
    </main>
  </body>
</html>
