---
import BaseLayout from "@/components/BaseLayout.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import SurvivalDatabase from "@/components/SurvivalDatabase.astro";
import type { Locale } from "@/i18n";

interface Props { locale: Locale }
const { locale } = Astro.props;
const copy = locale === "de" ? {
  title: "Welche alten Spiele sind noch spielbar?",
  description: "Eine quellenbasierte Datenbank zu Offline-Modi, Serverabschaltungen, Publisher-Logins und der langfristigen Spielbarkeit älterer Games.",
  eyebrow: "Can This Game Survive? · Survival Atlas",
  intro: "Eine überprüfbare Datenbank darüber, was von einem Spiel übrig bleibt, wenn Stores, Logins oder Server verschwinden.",
  current: "50 ausgewählte Spiele. Zwei veröffentlichte Befunde. Keine ungeprüften Urteile.",
  directTitle: "Eine URL pro Spiel. Eine klare Antwort.",
  directText: "Jeder veröffentlichte Datensatz beantwortet direkt, ob das Spiel noch zugänglich ist, welche Abhängigkeit kritisch ist und was nach einem Ausfall weiter funktioniert. Suchvarianten zu Offline-Modus, Serverabschaltung und Spielbarkeit werden auf derselben kanonischen Spielseite beantwortet.",
  method: "Methodik ansehen",
  rulesTitle: "Wann aus einem Kandidaten ein Datensatz wird",
  rules: [
    ["01", "Primärquellen", "Abschaltungen, Patches, Accounts und Serverzustände brauchen einen konkreten Beleg."],
    ["02", "Abhängigkeiten", "Installation, Berechtigung, Login, Server, lokaler Spielstand und Community-Infrastruktur werden getrennt erfasst."],
    ["03", "Begrenzte Aussage", "Publisher-Dokumentation, eigener Test, unterstützte Schlussfolgerung und Unbekanntes bleiben sichtbar getrennt."],
    ["04", "Pflege", "Jeder veröffentlichte Fall erhält Prüfdatum, nächste Prüfung, Quellenregister und Änderungsverlauf."],
  ],
} : {
  title: "Which older games are still playable?",
  description: "A source-led database of offline modes, server shutdowns, publisher logins and the long-term playability of older games.",
  eyebrow: "Can This Game Survive? · Survival Atlas",
  intro: "A reviewable database of what remains when a game's stores, logins or servers disappear.",
  current: "50 selected games. Two published findings. No unreviewed verdicts.",
  directTitle: "One URL per game. One clear answer.",
  directText: "Every published record answers whether the game remains accessible, which dependency is critical and what survives a service failure. Search questions about offline mode, server shutdown and playability are answered together on the same canonical game page.",
  method: "Read the methodology",
  rulesTitle: "How a candidate becomes a record",
  rules: [
    ["01", "Primary sources", "Shutdowns, patches, accounts and server states need a specific supporting source."],
    ["02", "Dependencies", "Installation, entitlement, login, servers, local saves and community infrastructure are recorded separately."],
    ["03", "Bounded finding", "Publisher documentation, direct testing, supported inference and unknowns remain visibly separate."],
    ["04", "Maintenance", "Every published case gets a review date, next review, source register and change history."],
  ],
};
const methodPath = locale === "de" ? "/de/survival-atlas/methodik/" : "/survival-atlas/methodology/";
---

<BaseLayout lang={locale} title={copy.title} description={copy.description}>
  <section class="atlas-hero shell" aria-labelledby="atlas-title">
    <p class="mono">{copy.eyebrow}</p>
    <div class="atlas-hero__main">
      <div><h1 id="atlas-title" class="display">{copy.title}</h1><p class="lede">{copy.intro}</p></div>
      <p class="current">{copy.current}</p>
    </div>
  </section>

  <div class="shell"><SurvivalDatabase locale={locale} /></div>

  <section class="answer-model shell">
    <div><p class="mono">{locale === "de" ? "Seitenmodell" : "Page model"}</p><h2 class="display">{copy.directTitle}</h2></div>
    <div><p>{copy.directText}</p><a class="action" href={methodPath}>{copy.method} <span aria-hidden="true">→</span></a></div>
  </section>

  <section class="record-gate shell" aria-labelledby="record-gate-title">
    <div><p class="mono">{locale === "de" ? "Veröffentlichungsgate" : "Publication gate"}</p><h2 id="record-gate-title" class="display">{copy.rulesTitle}</h2></div>
    <ol>{copy.rules.map(([number, title, text]) => <li><span class="mono">{number}</span><div><h3 class="display">{title}</h3><p>{text}</p></div></li>)}</ol>
  </section>

  <SiteFooter locale={locale} />
</BaseLayout>

<style>
  .atlas-hero { padding-block: clamp(4rem, 8vw, 7rem); border-bottom: 1px solid var(--line); }
  .atlas-hero > .mono { margin: 0 0 1rem; color: var(--signal); }
  .atlas-hero__main { display: grid; grid-template-columns: 1fr minmax(18rem, 0.36fr); gap: clamp(2rem, 7vw, 8rem); align-items: end; }
  .atlas-hero h1 { max-width: 12ch; font-size: clamp(3.8rem, 7.5vw, 7.5rem); }
  .lede { max-width: 48rem; margin: 1.35rem 0 0; color: var(--ink-soft); font-size: clamp(1.1rem, 1.8vw, 1.4rem); }
  .current { margin: 0; padding-top: 1rem; border-top: 1px solid var(--line-strong); color: var(--ink-soft); }
  .answer-model, .record-gate { display: grid; grid-template-columns: minmax(18rem, 0.7fr) 1fr; gap: clamp(3rem, 8vw, 9rem); padding-block: var(--section); border-bottom: 1px solid var(--line); }
  .answer-model .mono, .record-gate .mono { margin: 0 0 0.8rem; color: var(--signal); }
  .answer-model h2, .record-gate h2 { max-width: 11ch; font-size: clamp(2.7rem, 5vw, 5rem); }
  .answer-model > div:last-child { max-width: 45rem; }
  .answer-model > div:last-child p { margin: 0; color: var(--ink-soft); font-family: var(--display); font-size: clamp(1.35rem, 2.2vw, 1.9rem); line-height: 1.4; }
  .answer-model .action { margin-top: 2rem; }
  .record-gate ol { margin: 0; padding: 0; list-style: none; }
  .record-gate li { display: grid; grid-template-columns: 3rem 1fr; gap: 1.2rem; padding: 1.25rem 0; border-top: 1px solid var(--line); }
  .record-gate h3 { margin: 0; font-size: 1.35rem; font-weight: 550; }
  .record-gate li p { max-width: 42rem; margin: 0.35rem 0 0; color: var(--ink-soft); font-size: 0.9rem; }
  @media (max-width: 760px) {
    .atlas-hero__main, .answer-model, .record-gate { grid-template-columns: 1fr; gap: 2rem; }
    .atlas-hero h1 { font-size: clamp(3.6rem, 16vw, 6rem); }
  }
</style>
